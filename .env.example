# Copy to .env in the workspace root. Never commit real credentials.
# Local PostgreSQL is started separately with: devenv up postgres
DATABASE_URL=postgresql://localhost:5432/analytics
TEST_DATABASE_URL=postgresql://localhost:5432/analytics_test
# Production requires verified database TLS. For a private/self-signed CA, set
# DATABASE_SSL_CA to its PEM certificate with actual newlines.
# The database certificate must match the hostname in DATABASE_URL.
# Keep TLS options out of DATABASE_URL; sslmode=verify-full is accepted.
# DATABASE_SSL_CA=

# Select a model supporting tool calls. No model is hardcoded.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Use a stronger model for risk-based analytical review.
OPENROUTER_REVIEW_MODEL=openai/gpt-5.6-terra
# Independent plain-text titles after accepted prompts 1 and 3.
OPENROUTER_TITLE_MODEL=anthropic/claude-haiku-4.5

# Browser origin, also used for Google redirects and same-origin mutation checks.
# Production requires an explicit HTTPS origin and NODE_ENV=production.
APP_ORIGIN=http://localhost:5173
# Optional for guest-only local use. Configure both for Google login.
# Google OAuth client type: Web application. Register the exact redirect URI:
# http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# BigQuery jobs are billed to this Google Cloud project.
GOOGLE_CLOUD_PROJECT=
# Application Default Credentials: run gcloud auth application-default login,
# or uncomment this path to a service-account JSON file kept outside the repo.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Server deployments that cannot mount a credentials file (e.g. Railway) may
# instead set the raw service-account JSON inline; the process materializes it.
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# Google login (Sign in with Google). Create a "Web application" OAuth client
# in the Google Auth Platform (APIs & Services > Credentials) in the project
# above. Authorized JavaScript origin: http://localhost:5173
# Authorized redirect URI: <APP_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin of the frontend; drives the OAuth redirect URI. Must be HTTPS
# in production. Defaults to http://localhost:5173.
APP_ORIGIN=http://localhost:5173

PORT=3001
# Bind host. Local development binds loopback; containers should use 0.0.0.0.
# HOST=0.0.0.0
# Optional: when set, Express serves the built frontend from this directory.
# STATIC_DIR=/app/web/dist
# Optional BigQuery byte caps: 2 GiB/catalog, 1 GiB/ad-hoc, one 5 GiB turn ledger.
CATALOG_QUERY_MAX_BYTES=2147483648
QUERY_MAX_BYTES=1073741824
TURN_MAX_BYTES=5368709120

# devenv sets this automatically. Override only to use a different browser.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/absolute/path/to/chromium
