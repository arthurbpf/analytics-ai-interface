# Copy to .env in the workspace root. Never commit real credentials.
# Local PostgreSQL is started separately with: devenv up postgres
DATABASE_URL=postgresql://localhost:5432/analytics
TEST_DATABASE_URL=postgresql://localhost:5432/analytics_test

# Select a model supporting tool calls. No model is hardcoded.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# BigQuery jobs are billed to this Google Cloud project.
GOOGLE_CLOUD_PROJECT=
# Application Default Credentials: run gcloud auth application-default login,
# or uncomment this path to a service-account JSON file kept outside the repo.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

PORT=3001
# Optional BigQuery byte caps (1 GiB/query and 5 GiB/turn by default).
QUERY_MAX_BYTES=1073741824
TURN_MAX_BYTES=5368709120

# devenv sets this automatically. Override only to use a different browser.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/absolute/path/to/chromium
